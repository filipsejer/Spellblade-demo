# build output (run.sh compiles into out/; build.sh packs the jar in out_dist/ and writes it to dist/, and the jar
# players download is attached to the GitHub release instead of committed)
out/
out_dist/
dist/
*.class

# run.sh logs / crash dumps
game.log
hs_err_pid*.log

# macOS
.DS_Store

# dev scratch files: screenshots and audio taken while tuning graphics and sound (not part of the game)
*.wav
*.m4a
# ...but the recorded music in res/music is part of the game
!res/music/*.wav
[0-9]*_*.png
audio_*.png
